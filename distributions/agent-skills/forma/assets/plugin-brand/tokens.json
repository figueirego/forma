    "parts": [
      {
        "name": "haste",
        "x": 12,
        "y": 12,
        "width": 24,
        "height": 96
      },
      {
        "name": "barra-superior",
        "x": 42,
        "y": 12,
        "width": 66,
        "height": 24
      },
      {
        "name": "barra-central",
        "x": 42,
        "y": 48,
        "width": 48,
        "height": 24
      }
    ],
