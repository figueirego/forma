{
  "name": "Forma — identidade do plugin",
  "version": "1.0.0",
  "scope": "Apenas a marca e a apresentação do plugin Forma; não define o estilo dos projetos consumidores.",
  "primitives": {
    "color": {
      "blue": "#315BE8",
      "ink": "#172238",
      "paper": "#F5F4F0",
      "white": "#FFFFFF",
      "muted": "#596274",
      "line": "#C9CDD3",
      "darkMuted": "#B9C1D1",
      "darkLine": "#465167",
      "darkAccent": "#A8BCFF"
    },
    "space": {
      "unit": 6,
      "xs": 12,
      "sm": 18,
      "md": 24,
      "lg": 36,
      "xl": 48,
      "xxl": 72,
      "section": 120
    }
  },
  "semantic": {
    "light": {
      "background": "{primitives.color.paper}",
      "foreground": "{primitives.color.ink}",
      "muted": "{primitives.color.muted}",
      "line": "{primitives.color.line}",
      "accent": "{primitives.color.blue}",
      "surface": "{primitives.color.white}"
    },
    "dark": {
      "background": "{primitives.color.ink}",
      "foreground": "{primitives.color.paper}",
      "muted": "{primitives.color.darkMuted}",
      "line": "{primitives.color.darkLine}",
      "accent": "{primitives.color.darkAccent}",
