{
  "name": "forma-community",
  "version": "1.22.1",
  "private": true,
  "description": "Build and validation tooling for the Forma community Codex plugin",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "python3 -B tools/build.py",
    "check": "python3 -B tools/check.py",
    "test:python": "python3 -B -m unittest discover -s source/forma/tests -p 'test_*.py' -v",
    "test:builder": "python3 -B -m unittest discover -s tools -p 'test_*.py' -v",
    "test:node": "node tools/test-node.mjs",
    "check:generated": "python3 -B tools/build.py --check"
  },
  "devDependencies": {
    "three": "0.186.0"
  }
}
