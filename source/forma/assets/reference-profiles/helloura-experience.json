  "workflowPatterns": [
    {
      "id": "team-scope",
      "decision": "Show selected team at configuration and confirmation; isolate changes by team.",
      "evidence": "preview-code"
    },
    {
      "id": "progress-and-uncertainty",
      "decision": "Distinguish running, paused, completed and unconfirmed; offer review before retrying an uncertain action.",
      "evidence": "preview-code"
    },
    {
      "id": "operator-focus",
      "decision": "Keep attendance and personal audio/profile available without management navigation.",
      "evidence": "preview-code"
    },
    {
      "id": "call-outcomes",
      "decision": "Automatic unsuccessful-call outcomes and manual disposition for answered conversations remain product requirements; preview is not telephony proof.",
      "evidence": "user-requirement-and-preview-boundary"
    },
    {
      "id": "integrations",
      "decision": "Separate permission to configure from connection state. Explain recovery and owner of permission.",
      "evidence": "preview-code"
    },
    {
      "id": "free-top-up",
      "decision": "Partner chooses an amount; review team, amount and payment method before confirmation.",
      "evidence": "preview-code-not-real-payment"
    },
    {
      "id": "payer-and-tariffs",
      "decision": "Admin selects an existing team; team owns payer, tariff and release configuration. Do not infer fiscal identity from a manager login.",
      "evidence": "user-requirement-not-service-validation"
    },
    {
      "id": "honest-conversion",
      "decision": "Never claim a lead was sent, a call connected or a charge completed without actual confirmation.",
      "evidence": "landing-code-and-preview-boundary"
    }
  ],
