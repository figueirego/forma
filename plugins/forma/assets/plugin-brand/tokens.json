{
  "name": "Forma - plugin identity",
  "version": "1.0.0",
  "scope": "Only the Forma plugin's brand and presentation; does not define the style of consuming projects.",
  "primitives": {
    "color": {
      "blue": "#315BE8",
      "ink": "#172238",
      "paper": "#F5F4F0",
      "white": "#FFFFFF",
      "muted": "#596274",
      "line": "#C9CDD3",
      "darkMuted": "#B9C1D1",
      "darkLine": "#465167",
      "darkAccent": "#A8BCFF"
    },
    "space": {
      "unit": 6,
      "xs": 12,
      "sm": 18,
      "md": 24,
      "lg": 36,
      "xl": 48,
      "xxl": 72,
      "section": 120
    }
  },
  "semantic": {
    "light": {
      "background": "{primitives.color.paper}",
      "foreground": "{primitives.color.ink}",
      "muted": "{primitives.color.muted}",
      "line": "{primitives.color.line}",
      "accent": "{primitives.color.blue}",
      "surface": "{primitives.color.white}"
    },
    "dark": {
      "background": "{primitives.color.ink}",
      "foreground": "{primitives.color.paper}",
      "muted": "{primitives.color.darkMuted}",
      "line": "{primitives.color.darkLine}",
      "accent": "{primitives.color.darkAccent}",
      "surface": "#202D46"
    }
  },
  "typography": {
    "display": {
      "fontFamily": "Georgia, \"Times New Roman\", serif",
      "weight": 400,
      "lineHeight": 1.03
    },
    "body": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif",
      "weight": 400,
      "lineHeight": 1.55
    },
    "wordmark": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "weight": 600,
      "letterSpacing": "-0.065em"
    },
    "code": {
      "fontFamily": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
    }
  },
  "symbol": {
    "viewBox": [
      0,
      0,
      120,
      120
    ],
    "unit": 6,
    "bounds": [
      12,
      12,
      96,
      96
    ],
    "parts": [
      {
        "name": "haste",
        "x": 12,
        "y": 12,
        "width": 24,
        "height": 96
      },
      {
        "name": "barra-superior",
        "x": 42,
        "y": 12,
        "width": 66,
        "height": 24
      },
      {
        "name": "barra-central",
        "x": 42,
        "y": 48,
        "width": 48,
        "height": 24
      }
    ],
    "minimumCanvasPx": 24,
    "clearSpace": "At least 24 units (4u) outside the symbol's visible bounds; the SVG's internal padding does not replace this clear space."
  },
  "layout": {
    "maxWidthPx": 1440,
    "pageGutter": "clamp(24px, 5vw, 80px)",
    "breakpointsPx": {
      "small": 640,
      "medium": 960
    },
    "radius": 0
  },
  "assets": {
    "hero": {
      "path": "hero.png",
      "kind": "AI-generated presentation image, copied without changing its bytes",
      "notEvidenceOf": "3D model, geometry, physical material or interactive mechanism"
    },
    "canonicalMark": "icon.svg",
    "editableWordmark": "wordmark.svg"
  },
  "schema_version": 1,
  "format_note": "Simple local format; does not claim DTCG schema conformance."
}
