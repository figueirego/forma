      "sidebarLine": "#ffffff36",
      "sidebarField": "#db400d42",
      "primary": "#f64a06",
      "primaryInk": "#331e10",
      "dotOpacity": 0.12,
      "accountBackground": "#e9430cd9",
      "activeIndicator": "#ffd1ac",
      "lowerWash": "#fbd285",
      "lowerDots": "#fff6d4",
      "lowerOpacity": 0.26
    },
    "dark": {
      "page": "#1b1c1a",
      "surface": "#292a24",
      "ink": "#eeeee5",
      "muted": "#b3b2a1",
      "faint": "#22261f",
      "line": "#34342e",
      "sidebar": "#25231f",
      "sidebarInk": "#ecebdf",
      "sidebarMuted": "#d4d3c4",
