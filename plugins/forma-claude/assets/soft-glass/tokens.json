      "sidebarLine": "#ffffff14",
      "sidebarField": "#ffffff02",
      "primary": "#fc945a",
      "primaryInk": "#3a2415",
      "dotOpacity": 0.045,
      "accountBackground": "#3b3225c9",
      "activeIndicator": "#ffd1ac",
      "lowerWash": "#c49135",
      "lowerDots": "#c49135",
      "lowerOpacity": 0.11
    }
  },
  "layout": {
    "desktop": {
      "shellPaddingPx": 16,
      "shellGapPx": 15,
      "sidebarWidthPx": 226,
      "sidebarRadiusPx": 28,
      "panelRadiusPx": 26,
      "sidebarPaddingPx": [
        24,
        17
      ],
      "panelPaddingPx": [
        28,
        23,
        0
      ]
    },
    "mobile": {
      "maxWidthPx": 760,
      "shellPaddingPx": 8,
      "shellGapPx": 8,
      "sidebarWidthPx": 56,
      "sidebarRadiusPx": 16,
      "panelRadiusPx": 16,
      "panelPaddingPx": [
        20,
        14,
        0
      ]
    }
  },
  "dots": {
    "tilePx": 7,
    "solidRadiusPx": 0.75,
    "transparentRadiusPx": 1,
    "selectedIndicatorPx": 6,
    "selectedIndicatorColor": "#ffd1ac",
    "pointerEvents": "none"
  },
  "glass": {
    "angleDeg": 118,
    "blurPx": 6,
    "accountBlurPx": 9,
    "borderPx": 1,
    "independentOpaqueFallback": true
  },
  "motion": {
    "durationMs": 180,
    "hoverTranslateYPx": -1,
    "pressedTranslateYPx": 1,
    "reducedMotion": "no transitions or movement",
    "hoverQuery": "(hover: hover) and (pointer: fine)"
  },
  "typography": {
    "family": "system sans-serif",
    "referenceFontParity": false,
    "brandSizePx": 25,
    "navSizePx": 14,
    "titleSizePx": 25,
    "landingTitleMaxPx": 66
  },
  "dependencies": [],
  "adaptations": [
    "Neutral brand, English sample content, system fonts, and original inline icons",
    "Original CSS lower dot texture instead of proprietary artwork",
    "No fake browser title bar",
    "Preview-only theme and screen controls"
  ]
}
