{
  "schemaVersion": 1,
  "id": "soft-glass",
  "scope": ".forma-soft-glass",
  "modeAttribute": "data-theme",
  "purpose": "Design-only visual recipe; no business functionality",
  "themes": {
    "light": {
      "page": "#f8f6f2",
      "surface": "#fff9f2",
      "ink": "#42382e",
      "muted": "#807567",
      "faint": "#f8f4ec",
      "line": "#ded9d2",
      "sidebar": "#f6440f",
      "sidebarInk": "#fff8ed",
      "sidebarMuted": "#ffead8",
